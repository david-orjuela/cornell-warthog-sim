<launch>

    <param name="model_path" value="$(find reconstruct)/model/tree_yolov8n.pt" />
    <rosparam file="$(find reconstruct)/config/params.yaml" command="load" />

    <!-- Your custom node for processing joint states -->
<!--     <node name="reconstruct" pkg="reconstruct" type="reconstruct.py" output="screen"/> -->
<!--     <node name="map_camera_publisher" pkg="tf" type="static_transform_publisher" args="0.0 -0.03 0.0 -0.5 -0.5 -0.5 0.5 tool0 camera_base 10"/> -->
    <node name="pointcloud" pkg="reconstruct" type="pointcloud_processing.py" output="screen"/>
    <node name="scanning" pkg="reconstruct" type="motion_planner.py" output="screen"/>
    <node type="rviz" name="rviz" pkg="rviz" args="-d $(find reconstruct)/rviz/tfs.rviz" required="false"/>
</launch>
